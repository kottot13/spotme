# BigWigsMods packager config (github.com/BigWigsMods/packager).
# Enough for a simple single-folder addon.

package-as: SpotMe

# Use our own concise changelog for the release notes instead of the raw git log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Keep non-addon files out of the packaged zip:
ignore:
  - ".github"
  - ".gitignore"
  - ".luacheckrc"
  - "media"
  - "store-description.md"
  - "CLAUDE.md"

# No external libraries yet. If you later embed some (Ace3, LibStub,
# HereBeDragons), add them here, e.g.:
# externals:
#   Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
